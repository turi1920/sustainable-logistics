# ==============================================================================
# Sustainable Reverse Logistics System - Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Sustainable Reverse Logistics System"
API_V1_STR="/api/v1"
SECRET_KEY="change-this-to-a-secure-random-32-byte-hex-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Settings
# For local development with PostgreSQL:
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/reverse_logistics"
# For automated testing / fallback development:
# DATABASE_URL="sqlite+aiosqlite:///./reverse_logistics.db"

# Logistics & NRV Engine Defaults
DEFAULT_CURRENCY="USD"
AVERAGE_TRANSPORTATION_COST=15.00
DEFAULT_PACKAGING_COST=5.00
DEFAULT_SANITIZATION_COST=12.00

# 5-Day SLA Non-Response Workflow
SLA_TIMEOUT_DAYS=5
REMINDER_1_HOURS=48
REMINDER_2_HOURS=96
SLA_CHECK_INTERVAL_SECONDS=900

# File Storage
UPLOAD_STORAGE_PATH="./storage/uploads"
MAX_UPLOAD_SIZE_MB=10

# Frontend Configuration
BACKEND_API_BASE_URL="http://localhost:8000"
